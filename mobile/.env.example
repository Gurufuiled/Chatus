# =============================================================================
# Мобильное приложение — пример окружения (можно коммитить в корп. репозиторий)
# =============================================================================
# Публичные значения только (как и у любого OAuth mobile client). Секреты сервера сюда не кладём.
#
# Быстрый старт на Mac (Xcode / Cursor):
#   1) Скопируй этот файл в .env рядом (в папке mobile/):
#        cp .env.example .env
#   2) Установи зависимости:
#        npm install
#   3) Открой iOS-проект в Xcode (pods, workspace):
#        ./open-in-xcode.sh
#      или одной командой:
#        npx expo run:ios
#
# После смены .env перезапусти Metro (expo start) / пересобери в Xcode, чтобы подтянулся app.config.js.
# =============================================================================

# ---------------------------------------------------------------------------
# Прод-стенд команды (HTTP к VPS; ATS для этого хоста — в app.json → ios.infoPlist)
# Другой хост/HTTPS — замени строку; сокеты приложение строит с того же hostname (:4001, :4002).
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://45.11.93.210:4000/api

# Loginus: публичный client id (должен совпадать по смыслу с LOGINUS_CLIENT_ID на server для ЭТОГО стенда).
# Redirect в приложении: messenger://auth/callback
EXPO_PUBLIC_LOGINUS_CLIENT_ID=36bd25a329898885fd4b60c9f7b4f475

# ---------------------------------------------------------------------------
# Режимы
# ---------------------------------------------------------------------------
EXPO_PUBLIC_USE_MOCKS=false
# iOS Simulator: false. Android emulator: иногда true (localhost → 10.0.2.2).
EXPO_PUBLIC_USE_EMULATOR=false
EXPO_PUBLIC_USE_P2P=false

# -----------------------------------------------------------------------------
# Сеть (тот же хост, что в EXPO_PUBLIC_API_URL):
#   чат WebSocket → порт 4001 (ws:/wss:)
#   signaling P2P → порт 4002
# С симулятора/устройства порты должны быть доступны на сервере (или через прокси).
# -----------------------------------------------------------------------------

# Другой стенд (пример, не раскомментируй вместе с блоком выше — дублирует ключи):
# EXPO_PUBLIC_API_URL=https://api.example.com/api
# EXPO_PUBLIC_LOGINUS_CLIENT_ID=другой_public_client_id
