# =============================================================================
# Мобильное приложение — пример окружения (можно коммитить в корп. репозиторий)
# =============================================================================
# Публичные значения только (как и у любого OAuth mobile client). Секреты сервера сюда не кладём.
#
# Быстрый старт на Mac (Xcode / Cursor):
#   1) Скопируй этот файл в .env рядом (в папке mobile/):
#        cp .env.example .env
#   2) Установи зависимости:
#        npm install
#   3) Открой iOS-проект в Xcode (pods, workspace):
#        ./open-in-xcode.sh
#      или одной командой:
#        npx expo run:ios
#
# После смены .env перезапусти Metro (expo start) / пересобери в Xcode, чтобы подтянулся app.config.js.
#
# Release APK под прод: см. RELEASE-APK.md и скопируй .env.production.example → .env.production,
# затем собери с MOBILE_ENV=production (app.config.js подмешивает .env.production поверх .env).
# =============================================================================

# ---------------------------------------------------------------------------
# Push (Expo): project ID из `eas init` / вкладки Credentials в expo.dev — для getExpoPushTokenAsync в прод-сборке
# ---------------------------------------------------------------------------
# EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Локальная разработка: IP твоего ПК в Wi‑Fi (ipconfig / ifconfig), порт API как у server.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://192.168.1.104:4000/api

# Физический iPhone: если в EXPO_PUBLIC_API_URL указан http://localhost или 127.0.0.1,
# подставь сюда LAN-IP или hostname машины с API (тот же, что в ipconfig). Симулятор iOS не трогает.
# EXPO_PUBLIC_IOS_DEV_HOST=192.168.1.104

# ---------------------------------------------------------------------------
# Прод (VPS) — раскомментируй и отключи локальный URL выше
# ---------------------------------------------------------------------------
# EXPO_PUBLIC_API_URL=http://45.11.93.210:4000/api

# Loginus: публичный client id (должен совпадать по смыслу с LOGINUS_CLIENT_ID на server для ЭТОГО стенда).
# Redirect в приложении: messenger://auth/callback
EXPO_PUBLIC_LOGINUS_CLIENT_ID=36bd25a329898885fd4b60c9f7b4f475

# ---------------------------------------------------------------------------
# Режимы
# ---------------------------------------------------------------------------
EXPO_PUBLIC_USE_MOCKS=false
# iOS Simulator: false. Android emulator: иногда true (localhost → 10.0.2.2).
EXPO_PUBLIC_USE_EMULATOR=false

# -----------------------------------------------------------------------------
# Сеть (тот же хост, что в EXPO_PUBLIC_API_URL):
#   чат WebSocket → порт 4001 (ws:/wss:)
#   signaling WebRTC (звонки) → порт 4002
# С симулятора/устройства порты должны быть доступны на сервере (или через прокси).
# -----------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# APK updates (Android): манифест — raw GitHub (ветка main), см. config/client-update-manifest.json в Gurufuiled/Chatus.
# ---------------------------------------------------------------------------
# EXPO_PUBLIC_CLIENT_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/Gurufuiled/Chatus/main/config/client-update-manifest.json
# Совпадает с android.releaseTag в манифесте (новый APK без поднятия versionCode):
# EXPO_PUBLIC_CLIENT_RELEASE_TAG=1.0.3
# EXPO_PUBLIC_CLIENT_UPDATE_DISABLED=false
# В __DEV__ (expo start) по умолчанию проверка не запускается; для теста модалки:
# EXPO_PUBLIC_CLIENT_UPDATE_CHECK_IN_DEV=true
# Переопределение URL APK только если в манифесте нет ссылки (обычно не нужно — приоритет у driveApkFileId/apkUrl в JSON).
# EXPO_PUBLIC_CLIENT_UPDATE_APK_URL=https://drive.google.com/uc?export=download&id=FILE_ID

