# =============================================================================
# Локальный конфиг мобильного приложения (копия для друга / нового разработчика)
# =============================================================================
# 1. Скопируй этот файл как  .env  в ЭТУ ЖЕ папку  mobile/  (рядом с app.config.js)
#    Команда из корня репозитория:  copy mobile\.env.example mobile\.env   (Windows)
#    или:  cp mobile/.env.example mobile/.env   (macOS/Linux)
#
# 2. Подставь свои значения ниже. Секреты сервера сюда не кладём — только то,
#    что и так видно клиенту (публичный URL API, публичный OAuth client id).
#
# 3. Запуск iOS Simulator (на Mac, из папки mobile):
#    npm install
#    npx expo run:ios
#    (при первом запуске может понадобиться CocoaPods: cd ios && pod install)
#
# Сервер в этом шаблоне = твой прод: подставь реальный домен и client id от Loginus.
# =============================================================================

# Публичный URL REST API с суффиксом /api (как открывается в браузере с сервера).
# Примеры:
#   EXPO_PUBLIC_API_URL=https://api.example.com/api
#   EXPO_PUBLIC_API_URL=https://example.com/api
EXPO_PUBLIC_API_URL=https://REPLACE_WITH_YOUR_PROD_HOST/api

# Loginus OAuth — публичный client id (не client secret).
# Должен быть зарегистрирован с redirect URI: messenger://auth/callback
EXPO_PUBLIC_LOGINUS_CLIENT_ID=REPLACE_WITH_LOGINUS_PUBLIC_CLIENT_ID

# Реальные чаты через API/сокеты (не заглушки apiMocks).
EXPO_PUBLIC_USE_MOCKS=false

# iOS Simulator: оставь false. На Android-эмуляторе иногда ставят true (замена localhost → 10.0.2.2).
EXPO_PUBLIC_USE_EMULATOR=false

# Чаты через сервер (WebSocket). Включай P2P только если сознательно тестируешь WebRTC.
EXPO_PUBLIC_USE_P2P=false

# -----------------------------------------------------------------------------
# Важно про сеть (тот же хост, что в EXPO_PUBLIC_API_URL):
# Приложение само собирает URL сокетов с хоста API:
#   чат WebSocket   → порт 4001 (ws: или wss:)
#   signaling P2P   → порт 4002
# Убедись, что с телефона/симулятора эти порты доступны на проде (или прокси),
# иначе чаты в реальном времени не заработают.
# -----------------------------------------------------------------------------
