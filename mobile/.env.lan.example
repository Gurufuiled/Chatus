# LAN release APK (MOBILE_ENV=lan → npm run android:assembleRelease:lan)
# Замени 192.168.x.x на IP ПК в Wi‑Fi. server/.env: LIVEKIT_CLIENT_URL, LOGINUS_REDIRECT_URI на тот же хост.

EXPO_PUBLIC_API_URL=http://192.168.1.102:4000/api
EXPO_PUBLIC_LOGINUS_CLIENT_ID=95e69bdfc1331bb2f9d88ab41e8abc67
EXPO_PUBLIC_USE_MOCKS=false
EXPO_PUBLIC_USE_EMULATOR=false

EXPO_PUBLIC_P2P_FIRST_ENABLED=true
EXPO_PUBLIC_P2P_PEER_ATTEMPT_TIMEOUT_MS=2500
EXPO_PUBLIC_WEBRTC_ICE_SERVERS_JSON="[{\"urls\":\"stun:stun.l.google.com:19302\"}]"

EXPO_PUBLIC_LIVEKIT_URL=ws://192.168.1.102:7880
EXPO_PUBLIC_CLIENT_UPDATE_DISABLED=true
EXPO_PUBLIC_PRIVACY_POLICY_URL=http://192.168.1.102:4000/privacy-policy
