{
  "name": "mobile",
  "version": "1.0.17",
  "main": "index.ts",
  "scripts": {
    "postinstall": "patch-package",
    "build": "npx tsc --noEmit",
    "test": "node scripts/run-unit-tests.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:peer-delivery": "npx tsx src/services/PeerDeliveryService.test.ts",
    "test:p2p-send-decision": "npx tsx src/services/p2pSendDecision.test.ts",
    "test:line-sync-protocol": "npx tsx src/services/lineSyncProtocol.test.ts",
    "test:linesync-media-resolver": "npx tsx src/services/LineSyncMediaResolver.test.ts",
    "test:line-sync-ws": "npx tsx src/services/lineSyncWebSocket.test.ts",
    "test:line-sync-event-builder": "npx tsx src/services/lineSyncEventBuilder.test.ts",
    "test:transport": "npx tsx src/utils/messageTransport.test.ts",
    "test:telegram-chat": "npx tsx src/screens/telegramChat/tdlibPhotoUtils.test.ts && npx tsx src/screens/telegramChat/telegramDialogFallback.test.ts && npx tsx src/screens/telegramChat/telegramChannelPostLayout.test.ts",
    "test:voice": "npx tsx src/services/VoiceRecorderService.test.ts",
    "test:voice-gesture": "npx tsc --noEmit",
    "start": "expo start",
    "android": "expo run:android",
    "preandroid:release:prod": "node ./scripts/assertGradleVersionMatchesAppJson.mjs",
    "android:release": "cross-env CI=1 expo run:android --variant release",
    "android:release:prod": "cross-env CI=1 MOBILE_ENV=production expo run:android --variant release",
    "android:assembleRelease:prod": "cross-env MOBILE_ENV=production node ./scripts/assembleRelease.mjs",
    "wallpapers:regenerate": "python ./scripts/regenerate_chat_wallpapers.py",
    "tdlib:fetch-android": "node ./scripts/fetchTdlibAndroid.mjs",
    "tdlib:fetch-ios": "node ./scripts/fetchTdlibIos.mjs",
    "tdlib:build-ios": "node ./scripts/buildTdlibIos.mjs",
    "notification:icon": "node ./scripts/generate-notification-icon-small.mjs",
    "eas-build-pre-install": "node ./scripts/easBuildPreinstall.mjs",
    "android:prebuild:clean": "expo prebuild --platform android --clean",
    "eas:android": "cross-env MOBILE_ENV=production npx eas-cli build --platform android --non-interactive",
    "android:emulator": "expo run:android -d Pixel_4_API_36 --no-bundler",
    "android:device": "expo run:android -d eq4xhqrs6d5dbeeu",
    "adb:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:4000 tcp:4000 && adb reverse tcp:4001 tcp:4001 && adb reverse tcp:4002 tcp:4002",
    "adb:reverse:emulator": "adb -s emulator-5554 reverse tcp:8081 tcp:8081 && adb -s emulator-5554 reverse tcp:4000 tcp:4000 && adb -s emulator-5554 reverse tcp:4001 tcp:4001 && adb -s emulator-5554 reverse tcp:4002 tcp:4002",
    "adb:reverse:device": "adb -s eq4xhqrs6d5dbeeu reverse tcp:8081 tcp:8081 && adb -s eq4xhqrs6d5dbeeu reverse tcp:4000 tcp:4000 && adb -s eq4xhqrs6d5dbeeu reverse tcp:4001 tcp:4001 && adb -s eq4xhqrs6d5dbeeu reverse tcp:4002 tcp:4002",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "release:github": "node ../scripts/upload-apk-github.mjs",
    "test:jest": "jest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/core": "7.16.1",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "expo": "~55.0.17",
    "expo-asset": "~55.0.16",
    "expo-av": "^16.0.8",
    "expo-blur": "~55.0.14",
    "expo-build-properties": "~55.0.13",
    "expo-camera": "~55.0.16",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.7",
    "expo-contacts": "~55.0.14",
    "expo-crypto": "~55.0.15",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.17",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.9",
    "expo-image-manipulator": "~55.0.15",
    "expo-image-picker": "~55.0.19",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.14",
    "expo-media-library": "~55.0.15",
    "expo-notifications": "~55.0.20",
    "expo-secure-store": "~55.0.13",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-video": "~55.0.15",
    "expo-video-thumbnails": "~55.0.14",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-webrtc": "^124.0.7",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.18",
    "patch-package": "^8.0.1",
    "react-test-renderer": "^19.2.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@react-navigation/core": "7.16.1",
    "react-native-worklets": "0.7.4"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc",
          "expo-av"
        ]
      }
    }
  },
  "private": true
}
