{
  "expo": {
    "plugins": [
      "./plugins/withAndroidApkBasename",
      "./plugins/withTdlibNative",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification_icon_small.png",
          "color": "#4B8FEA",
          "defaultChannel": "chatus_messages",
          "sounds": ["./assets/sounds/message_notification.wav"]
        }
      ],
      "./plugins/withAndroidNotificationLargeIcon",
      [
        "expo-camera",
        {
          "cameraPermission": "Разрешите доступ к камере для записи видеокружков.",
          "microphonePermission": "Разрешите доступ к микрофону для записи видеокружков.",
          "recordAudioAndroid": true
        }
      ],
      "expo-video",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите доступ к фото для выбора изображений и аватара.",
          "cameraPermission": "Разрешите доступ к камере для съёмки и аватара."
        }
      ],
      "expo-image",
      "./plugins/withIosProductionPlist"
    ],
    "name": "Chatus",
    "slug": "chatus",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/chatus_icon.png",
    "userInterfaceStyle": "light",
    "scheme": ["messenger", "chatus"],
    "splash": {
      "image": "./assets/chatus_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E7EBF0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chatus.app",
      "infoPlist": {
        "CFBundleDisplayName": "Chatus",
        "LSMinimumSystemVersion": "15.1",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "messenger.startapus.com": {
              "NSIncludesSubdomains": true
            },
            "45.11.93.210": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },
    "android": {
      "versionCode": 2064630320,
      "icon": "./assets/chatus_icon.png",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "messenger",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/chatus_icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.chatus.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
