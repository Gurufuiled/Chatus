# =============================================================================
# Прод-сборка APK / iOS TestFlight (шаблон → скопируй в .env.production в папке mobile/).
# =============================================================================
#
# Перед release:
#   MOBILE_ENV=production   (macOS/Linux)
#   $env:MOBILE_ENV="production"   (PowerShell)
#
# iOS Xcode Archive: дополнительно создай mobile/ios/.xcode.env.local:
#   export MOBILE_ENV=production
#   export NODE_ENV=production
#
# API — тот же origin, что server/.env (LOGINUS_REDIRECT_URI / PUBLIC_ORIGIN).
# WS: wss://messenger.startapus.com:4001, signaling: :4002 (из EXPO_PUBLIC_API_URL в config.ts).
# LiveKit: wss://messenger.startapus.com/livekit
# =============================================================================

EXPO_PUBLIC_API_URL=https://messenger.startapus.com/api
EXPO_PUBLIC_LOGINUS_CLIENT_ID=95e69bdfc1331bb2f9d88ab41e8abc67
EXPO_PUBLIC_USE_MOCKS=false
EXPO_PUBLIC_USE_EMULATOR=false
EXPO_PUBLIC_P2P_FIRST_ENABLED=true
EXPO_PUBLIC_P2P_PEER_ATTEMPT_TIMEOUT_MS=2500
EXPO_PUBLIC_WEBRTC_ICE_SERVERS_JSON="[{\"urls\":\"stun:stun.l.google.com:19302\"}]"

EXPO_PUBLIC_LIVEKIT_URL=wss://messenger.startapus.com/livekit

# Android OTA (на iOS TestFlight лучше true — без sideload APK)
EXPO_PUBLIC_CLIENT_UPDATE_MANIFEST_URL=https://messenger.startapus.com/client-update-manifest.json
EXPO_PUBLIC_CLIENT_RELEASE_TAG=1.0.17
EXPO_PUBLIC_CLIENT_UPDATE_DISABLED=false
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://messenger.startapus.com/privacy-policy

# Telegram / TDLib — подставь свои с my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
