# =============================================================================
# Прод-сборка APK / release (шаблон → скопируй в .env.production в папке mobile/).
# =============================================================================
#
# Перед сборкой release задай в терминале:
#   MOBILE_ENV=production   (macOS/Linux)
#   $env:MOBILE_ENV="production"   (PowerShell)
# затем:
#   npx expo run:android --variant release
#
# API — тот же публичный origin, что server/.env (LOGINUS_REDIRECT_URI / PUBLIC_ORIGIN).
# WS: wss://messenger.startapus.com:4001, signaling: :4002 (из EXPO_PUBLIC_API_URL в config.ts).
# Манифест OTA: https://messenger.startapus.com/client-update-manifest.json (тот же VPS, что API).
# =============================================================================

EXPO_PUBLIC_API_URL=https://messenger.startapus.com/api
EXPO_PUBLIC_LOGINUS_CLIENT_ID=95e69bdfc1331bb2f9d88ab41e8abc67
EXPO_PUBLIC_USE_MOCKS=false
EXPO_PUBLIC_USE_EMULATOR=false
EXPO_PUBLIC_P2P_FIRST_ENABLED=true
EXPO_PUBLIC_P2P_PEER_ATTEMPT_TIMEOUT_MS=2500
# Публичный STUN; для части сетей без TURN peer может не подняться — см. mobile/.env.example.
EXPO_PUBLIC_WEBRTC_ICE_SERVERS_JSON="[{\"urls\":\"stun:stun.l.google.com:19302\"}]"

# Манифест OTA: с того же домена, что API. После правки config/client-update-manifest.json — docker compose up -d --build на VPS.
EXPO_PUBLIC_CLIENT_UPDATE_MANIFEST_URL=https://messenger.startapus.com/client-update-manifest.json
# Метка релиза: должна совпадать с android.releaseTag в config/client-update-manifest.json (при смене — предлагаем apk без versionCode)
EXPO_PUBLIC_CLIENT_RELEASE_TAG=1.0.17
# false — in-app OTA с messenger.startapus.com; true только для RuStore/Play без sideload.
EXPO_PUBLIC_CLIENT_UPDATE_DISABLED=false
# Политика конфиденциальности (экран входа). По умолчанию — {origin API}/privacy-policy
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://messenger.startapus.com/privacy-policy
# EXPO_PUBLIC_CLIENT_UPDATE_CHECK_IN_DEV=false
#
# TDLib / Telegram-аккаунт в release (my.telegram.org → API development tools):
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=your_api_hash_here
#
# Опционально: запасной URL на APK, если в манифесте нет ссылки (обычно не нужен: driveApkFileId / apkUrl в JSON имеют приоритет).
# EXPO_PUBLIC_CLIENT_UPDATE_APK_URL=https://drive.google.com/uc?export=download&id=YOUR_FILE_ID
