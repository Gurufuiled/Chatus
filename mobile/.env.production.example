# =============================================================================
# Прод-сборка APK / release (копируй в .env.production рядом с этим файлом)
# Файл .env.production в git не попадает (.gitignore). Этот пример — коммитится.
# =============================================================================
#
# Перед сборкой release задай в терминале:
#   MOBILE_ENV=production   (macOS/Linux)
#   $env:MOBILE_ENV="production"   (PowerShell)
# затем:
#   npx expo run:android --variant release
#
# API — тот же хост, что в server/.env для Loginus redirect (обычно VPS).
# Манифест обновлений и ссылка на APK в git — см. config/client-update-manifest.json (публичный репо Gurufuiled/Chatus).
# =============================================================================

EXPO_PUBLIC_API_URL=http://45.11.93.210:4000/api
EXPO_PUBLIC_LOGINUS_CLIENT_ID=36bd25a329898885fd4b60c9f7b4f475
EXPO_PUBLIC_USE_MOCKS=false
EXPO_PUBLIC_USE_EMULATOR=false

# Манифест (JSON): raw с публичного GitHub — после push репозитория клиенты видят новый releaseTag без деплоя API.
EXPO_PUBLIC_CLIENT_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/Gurufuiled/Chatus/main/config/client-update-manifest.json
# Метка релиза: должна совпадать с android.releaseTag в config/client-update-manifest.json (при смене — предлагаем apk без versionCode)
EXPO_PUBLIC_CLIENT_RELEASE_TAG=1.0.5
# EXPO_PUBLIC_CLIENT_UPDATE_DISABLED=false
# EXPO_PUBLIC_CLIENT_UPDATE_CHECK_IN_DEV=false
#
# Опционально: полный https на APK (например Google Drive uc?id=…). Кнопка «Обновить» откроет его вместо android.apkUrl из манифеста.
# EXPO_PUBLIC_CLIENT_UPDATE_APK_URL=https://drive.google.com/uc?export=download&id=YOUR_FILE_ID
