# Скопируй, переименовав рядом с Gradle-проектом Android:
#   из: mobile/scripts/android-release-keystore.properties.example
#   в:  mobile/android/keystore.properties
#
# Сгенерируй keystore (один раз), положи файл в android/app/, например:
#   cd mobile/android/app
#   keytool -genkeypair -v -storetype PKCS12 -keystore chatus-upload.keystore \
#     -alias chatus_upload -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass YOUR_STORE_PASS -keypass YOUR_KEY_PASS \
#     -dname "CN=Chatus, OU=Mobile, O=Chatus, L=City, ST=Region, C=RU"
#
# Путь storeFile — относительно папки mobile/android/ (не app/).

storeFile=app/chatus-upload.keystore
storePassword=YOUR_STORE_PASS
keyAlias=chatus_upload
keyPassword=YOUR_KEY_PASS
