// Prisma schema for messenger backend
// Aligned with mobile SQLite schema where applicable
// Run: npx prisma generate | npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum ChatType {
  private
  group
  channel
  discussion
}

enum ChatVisibility {
  public
  private
}

enum ChatAccessType {
  free
  paid
}

enum MessageType {
  text
  image
  voice
  video_note
  video
  file
  system
}

enum MediaType {
  image
  voice
  video_note
  video
  file
}

enum MessageStatus {
  pending
  sent
  delivered
  read
}

enum Transport {
  p2p
  websocket
}

enum FeedbackType {
  bug
  suggestion
}

enum FeedbackStatus {
  open
  closed
}

enum ChatMemberRole {
  owner
  admin
  member
}

enum SubscriptionStatus {
  none
  pending
  active
  expired
  canceled
}

// --- Models ---

model User {
  id           String    @id @default(uuid())
  loginusId    String?   @unique @map("loginus_id") // OAuth Loginus user id
  username     String?   @unique
  handle       String?   @unique @map("handle")
  displayName  String?   @map("display_name")
  avatarUrl    String?   @map("avatar_url")
  phone        String?   @unique
  isOnline     Boolean   @default(false) @map("is_online")
  lastSeen     DateTime? @map("last_seen")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  chatMembers   ChatMember[]
  createdChats  Chat[]         @relation("ChatCreator")
  messages      Message[]
  messageReactions MessageReaction[]
  channelPostViews ChannelPostView[]
  developerProfile DeveloperProfile?
  feedbackEntries FeedbackEntry[]
  pushDevices     PushDevice[]

  @@map("users")
}

model PushDevice {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  expoToken String   @unique @map("expo_token")
  platform  String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

model FeedbackEntry {
  id             String         @id @default(uuid())
  type           FeedbackType
  status         FeedbackStatus @default(open)
  title          String
  body           String
  attachmentUrl  String?        @map("attachment_url")
  authorId       String         @map("author_id")
  createdAt      DateTime       @default(now()) @map("created_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([type, createdAt])
  @@map("feedback_entries")
}

model DeveloperProfile {
  userId              String    @id @map("user_id")
  agreementAcceptedAt DateTime  @map("agreement_accepted_at")
  agreementVersion    String    @default("1.0") @map("agreement_version")
  createdAt           DateTime  @default(now()) @map("created_at")

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apps MiniApp[]

  @@map("developer_profiles")
}

model MiniApp {
  id           String   @id @default(uuid())
  shortId      String   @unique @map("short_id")
  ownerId      String   @map("owner_id")
  title        String
  description  String?
  iconUrl      String?  @map("icon_url")
  baseUrl      String   @map("base_url")
  allowedHosts String[] @default([]) @map("allowed_hosts")
  secret       String
  isPublished  Boolean  @default(false) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner DeveloperProfile @relation(fields: [ownerId], references: [userId], onDelete: Cascade)

  @@index([ownerId])
  @@index([isPublished])
  @@map("mini_apps")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Chat {
  id                  String    @id @default(uuid())
  chatType            ChatType  @map("chat_type")
  name                String?
  description         String?
  avatarUrl           String?   @map("avatar_url")
  visibility          ChatVisibility @default(public)
  accessType          ChatAccessType @default(free) @map("access_type")
  subscriptionPriceCents Int?   @map("subscription_price_cents")
  subscriptionPeriodDays Int?   @map("subscription_period_days")
  linkedDiscussionChatId String? @map("linked_discussion_chat_id")
  inviteToken         String?   @unique @map("invite_token")
  allowComments       Boolean   @default(true) @map("allow_comments")
  allowReactions      Boolean   @default(true) @map("allow_reactions")
  disableCommentsNew  Boolean   @default(false) @map("disable_comments_new")
  disableCommentsNewSince DateTime? @map("disable_comments_new_since")
  disableCommentsAll  Boolean   @default(false) @map("disable_comments_all")
  disableVoiceComments Boolean  @default(false) @map("disable_voice_comments")
  disableMediaComments Boolean  @default(false) @map("disable_media_comments")
  commentCooldownSec  Int       @default(0) @map("comment_cooldown_sec")
  slug                String?   @unique
  previewPostCount    Int       @default(3) @map("preview_post_count")
  subscriberCount     Int       @default(0) @map("subscriber_count")
  activeSubscriberCount Int     @default(0) @map("active_subscriber_count")
  pendingEarningsCents Int      @default(0) @map("pending_earnings_cents")
  availablePayoutCents Int      @default(0) @map("available_payout_cents")
  paidOutCents        Int       @default(0) @map("paid_out_cents")
  createdById         String    @map("created_by_id")
  lastMessageId       String?   @map("last_message_id")
  pinnedMessageId     String?   @map("pinned_message_id")
  lastMessageAt       DateTime? @map("last_message_at")
  lastMessagePreview  String?   @map("last_message_preview")
  unreadCount         Int       @default(0) @map("unread_count") // per-chat, can be computed per user
  isMuted             Boolean   @default(false) @map("is_muted")
  isPinned            Boolean   @default(false) @map("is_pinned")
  isArchived          Boolean   @default(false) @map("is_archived")
  draft               String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  createdBy   User        @relation("ChatCreator", fields: [createdById], references: [id], onDelete: Cascade)
  lastMessage Message?    @relation("ChatLastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  pinnedMessage Message?  @relation("ChatPinnedMessage", fields: [pinnedMessageId], references: [id], onDelete: SetNull)
  members     ChatMember[]
  messages    Message[]

  @@index([createdById])
  @@index([lastMessageAt])
  @@map("chats")
}

model ChatMember {
  chatId   String        @map("chat_id")
  userId   String        @map("user_id")
  role     ChatMemberRole @default(member)
  accessStatus SubscriptionStatus @default(active) @map("access_status")
  subscriptionExpiresAt DateTime? @map("subscription_expires_at")
  tag      String?
  tagColor String?       @map("tag_color")
  joinedAt DateTime      @default(now()) @map("joined_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_members")
}

model Message {
  id                     String        @id @default(uuid())
  chatId                 String        @map("chat_id")
  senderId               String        @map("sender_id")
  msgType                MessageType   @map("msg_type")
  content                String?
  replyToId              String?       @map("reply_to_id")
  threadRootMessageId    String?       @map("thread_root_message_id")
  forwardedFromMessageId String?       @map("forwarded_from_message_id")
  forwardedFromName      String?       @map("forwarded_from_name")
  forwardedFromChatId    String?       @map("forwarded_from_chat_id")
  forwardedFromSenderId  String?       @map("forwarded_from_sender_id")
  isChannelPost          Boolean       @default(false) @map("is_channel_post")
  viewCount              Int           @default(0) @map("view_count")
  commentCount           Int           @default(0) @map("comment_count")
  isEdited               Boolean       @default(false) @map("is_edited")
  isDeleted              Boolean       @default(false) @map("is_deleted")
  status                 MessageStatus @default(pending)
  transport              Transport?    // p2p or websocket
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo    Message? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    Message[] @relation("MessageReplies")
  reactions  MessageReaction[]
  views      ChannelPostView[]
  media      Media[]
  chatsAsLastMessage Chat[] @relation("ChatLastMessage")
  chatsAsPinnedMessage Chat[] @relation("ChatPinnedMessage")

  @@index([chatId])
  @@index([senderId])
  @@index([replyToId])
  @@index([threadRootMessageId])
  @@index([forwardedFromMessageId])
  @@index([forwardedFromChatId])
  @@index([forwardedFromSenderId])
  @@index([createdAt])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("message_reactions")
}

model ChannelPostView {
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@map("channel_post_views")
}

model Media {
  id          String    @id @default(uuid())
  messageId   String    @map("message_id")
  mediaType   MediaType @map("media_type")
  fileName    String?   @map("file_name")
  mimeType    String?   @map("mime_type")
  fileSize    Int?      @map("file_size")
  width       Int?
  height      Int?
  durationMs  Int?      @map("duration_ms")
  remoteUrl   String?   @map("remote_url") // S3 or server path
  thumbnailUrl String?  @map("thumbnail_url")
  waveform    Bytes?    // voice/video_note waveform data
  isRound     Boolean   @default(false) @map("is_round")
  createdAt   DateTime  @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("media")
}
