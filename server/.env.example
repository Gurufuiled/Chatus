# Server
PORT=4000
WS_PORT=4001
SIGNALING_PORT=4002
# По умолчанию 5433: на Windows порт 55432 иногда в системном excluded range и Docker не может его открыть.
POSTGRES_PORT=5433

# Database (PostgreSQL)
# Локальный dev с docker-базой: сервер на хосте, Postgres в compose.
# Внутри compose сам api-контейнер использует DATABASE_URL из docker-compose.yml.
DATABASE_URL="postgresql://messenger:messenger_local_only_change_me@127.0.0.1:5433/messenger"

# Docker Compose: пароль пользователя messenger в контейнере postgres (обязательно смени на проде)
POSTGRES_PASSWORD=messenger_local_only_change_me

# JWT
JWT_SECRET="your-secret-key-change-in-production"

# Expo Push (опционально): токен из https://expo.dev → Project → Access tokens — выше лимиты при массовой рассылке
# EXPO_ACCESS_TOKEN=

# Loginus OAuth API (https://loginus.startapus.com)
# client_secret хранится ТОЛЬКО на backend (см. .cursor/rules/auth.mdc)
LOGINUS_BASE_URL=https://loginus.startapus.com
LOGINUS_CLIENT_ID=36bd25a329898885fd4b60c9f7b4f475
LOGINUS_CLIENT_SECRET=replace-with-secret-from-loginus-panel
# Redirect URI — HTTP, должен совпадать с настройкой в Loginus.
# Loginus редиректит сюда, backend перенаправляет в messenger://
#
# Локальная разработка (IP ПК в LAN):
LOGINUS_REDIRECT_URI=http://192.168.1.85:4000/api/auth/callback
LOGINUS_REDIRECT_URI_LOGOUT=http://192.168.1.85:4000/api/auth/logout-done
#
# Прод (VPS) — замени на свой публичный IP/домен; то же добавь в кабинете Loginus:
# LOGINUS_REDIRECT_URI=http://YOUR_VPS_IP:4000/api/auth/callback
# LOGINUS_REDIRECT_URI_LOGOUT=http://YOUR_VPS_IP:4000/api/auth/logout-done

# Логи (Pino): при NODE_ENV=production — JSON; иначе цветной вывод pino-pretty.
# Уровень: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info

# Optional Rust media worker
# Keep disabled by default until the binary is built and validated.
RUST_MEDIA_WORKER_ENABLED=false
# Optional worker timeout in milliseconds.
RUST_MEDIA_WORKER_TIMEOUT_MS=120000
# Optional explicit path. If empty, server will try:
# rust/target/release/media-worker(.exe)
# rust/target/debug/media-worker(.exe)
RUST_MEDIA_WORKER_BIN=

# Chatus P2P-first / mailbox policy (native messages only; Telegram/TDLib is not affected).
# Peer timeout controls when clients should fall back to server mailbox.
P2P_PEER_ATTEMPT_TIMEOUT_MS=2500
# Boolean parser accepts 1/0 and true/false.
P2P_PEER_METRICS_ENABLED=1

# Server mailbox/cache policy for messages/media that reached the server fallback.
# Defaults preserve current mailbox behaviour: websocket transport, no TTL-based deletion.
RELAY_MODE=standard
RELAY_TEXT_CACHE_SECONDS=0
RELAY_DELETE_AFTER_ALL_DEVICES_ACK=0
RELAY_MEDIA_CACHE_SECONDS=0
RELAY_MEDIA_RETAIN_UNTIL_DOWNLOAD=1
# RELAY_MEDIA_MAX_BYTES=
# RELAY_GROUP_TEXT_CACHE_SECONDS=
# RELAY_CHANNEL_POST_RETENTION_SECONDS=
# RELAY_CHANNEL_MEDIA_MIN_RETENTION_SECONDS=
# RELAY_FANOUT_MAX_CONCURRENT=
