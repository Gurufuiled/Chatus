{
  "name": "chatus-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "vite --config vite.app.config.ts",
    "build": "npm run build:embed && npm run build:app",
    "build:embed": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:app": "tsc -p tsconfig.app.json --noEmit && vite build --config vite.app.config.ts",
    "preview": "vite preview",
    "preview:app": "vite preview --config vite.app.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.69.0",
    "@tanstack/react-router": "^1.114.25",
    "buffer": "^6.0.3",
    "ebml": "3.0.0",
    "livekit-client": "^2.20.0",
    "mediabunny": "^1.50.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-ebml": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.9"
  }
}
