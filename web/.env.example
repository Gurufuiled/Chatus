# API base URL (empty = same origin / vite proxy)
# VITE_API_BASE_URL=

# WebSocket URL (phase 1.7+)
# VITE_WS_URL=ws://localhost:4001

# Comma-separated Loginus parent origins for postMessage allowlist
VITE_LOGINUS_ORIGINS=https://id.startapus.com,https://loginus.startapus.com,http://localhost:5173

# Dev: UI preview with mock data (no server/token) — for layout demo
# VITE_DEV_UI_PREVIEW=true

# Dev: skip Loginus embed auth (requires VITE_DEV_ACCESS_TOKEN from mobile login)
VITE_DEV_SKIP_EMBED_AUTH=false
# VITE_DEV_ACCESS_TOKEN=
